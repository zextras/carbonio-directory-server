pkgname="carbonio-common-ldap-conf"
pkgver="4.23.1"
pkgrel="1"
pkgdesc="Carbonio Attributes and Rights Configuration"
arch=('x86_64')
maintainer="Zextras <packages@zextras.com>"
copyright=(
  "2022-2024, Zextras <https://www.zextras.com>"
  "2022, Synacor, Inc."
)
license=(
  "GPL-2.0-only"
)
url="https://github.com/zextras"
section="mail"
priority="optional"

package() {

  cd "$(dirname "$(find / -name "yap.json" -print -quit)")"

  # TODO: attrs-schema should be moved to directory-server
  install -D "src/ldap/generated/attrs-schema" \
    "${pkgdir}/opt/zextras/conf/attrs-schema"

  install -D "src/main/resources/conf/attrs/amavisd-new-attrs.xml" \
    "${pkgdir}/opt/zextras/doc/conf/attrs/amavisd-new-attrs.xml"
  install -D "src/main/resources/conf/attrs/attrs.xml" \
    "${pkgdir}/opt/zextras/doc/conf/attrs/attrs.xml"
  install -D "src/main/resources/conf/attrs/ocs.xml" \
    "${pkgdir}/opt/zextras/doc/conf/attrs/ocs.xml"

  install -D "src/main/resources/conf/rights/adminconsole-ui.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/adminconsole-ui.xml"
  install -D "src/main/resources/conf/rights/rights-adminconsole-domainadmin.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/rights-adminconsole-domainadmin.xml"
  install -D "src/main/resources/conf/rights/rights-adminconsole.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/rights-adminconsole.xml"
  install -D "target/generated-resources/conf/rights/rights-domainadmin.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/rights-domainadmin.xml"
  install -D "src/main/resources/conf/rights/rights-roles.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/rights-roles.xml"
  install -D "src/main/resources/conf/rights/rights.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/rights.xml"
  install -D "src/main/resources/conf/rights/user-rights.xml" \
    "${pkgdir}/opt/zextras/doc/conf/rights/user-rights.xml"
}


