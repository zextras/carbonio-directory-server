pkgname="carbonio-directory-server"
pkgver="4.27.1"
pkgrel="1"
pkgdesc="An open-source, community-driven email server"
maintainer="Zextras <packages@zextras.com>"
copyright=(
  "2022-2024, Zextras <https://www.zextras.com>"
  "2022, Synacor, Inc."
)
license=(
  "GPL-2.0-only"
)
url="https://github.com/zextras"
section="mail"
priority="optional"
arch=('x86_64')
depends=(
  "carbonio-core"
  "carbonio-prometheus-openldap-exporter"
)
makedepends=(
  "rsync"
)

_package() {
  cd "$(dirname "$(find / -name "yap.json" -print -quit)")"

  local confdir="${pkgdir}/opt/zextras/conf/externaldirsync"
  install -D src/ldap/externaldirsync/Exchange2000.xml \
    "${confdir}/Exchange2000.xml"
  install -D src/ldap/externaldirsync/Exchange2003.xml \
    "${confdir}/Exchange2003.xml"
  install -D src/ldap/externaldirsync/Exchange5.5.xml \
    "${confdir}/Exchange5.5.xml"
  install -D src/ldap/externaldirsync/domino.xml \
    "${confdir}/domino.xml"
  install -D src/ldap/externaldirsync/novellGroupWise.xml \
    "${confdir}/novellGroupWise.xml"
  install -D src/ldap/externaldirsync/openldap.xml \
    "${confdir}/openldap.xml"

  local migrdir="${pkgdir}/opt/zextras/libexec/scripts/LDAP/migrations"
  mkdir -p "${migrdir}"
  rsync -a src/ldap/src/migrations/ "${migrdir}/"
  chmod -R +x "${migrdir}/"

  install -D src/ldap/src/LdapMigrationUtils.pm \
    "${pkgdir}/opt/zextras/common/lib/perl5/Zextras/LdapMigrationUtils.pm"
  install -D src/ldap/src/LdapPreFlight.pl \
    "${pkgdir}/opt/zextras/libexec/scripts/LDAP/LdapPreFlight.pl"

  local schemadir="${pkgdir}/opt/zextras/common/etc/openldap/zimbra"
  install -Ddm755 src/ldap/generated/ "${schemadir}/"
  rsync -a src/ldap/generated/ "${schemadir}/"

  install -Dm644 "directory-server/systemd-tmpfile.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
}

_package_systemd() {
  local sysdir="${pkgdir}/usr/lib/systemd/system"

  install -Dm644 "directory-server/${pkgname}.target" \
    "${sysdir}/${pkgname}.target"
}

_ldap_upgrade_legacy() {
  echo "* Starting LDAP upgrade..."
  su - zextras -c "/opt/zextras/libexec/scripts/LDAP/LdapPreFlight.pl"
  su - zextras -c "/opt/zextras/bin/ldap stop"
  su - zextras -c "/opt/zextras/libexec/zmldapschema 2>/dev/null"
  /opt/zextras/libexec/zmldapupdateldif
  /opt/zextras/libexec/ldapattributeupdate
  su - zextras -c "/opt/zextras/bin/ldap restart"
}

_ldap_upgrade_systemd() {
  echo "* Starting LDAP upgrade..."
  su - zextras -c "/opt/zextras/libexec/scripts/LDAP/LdapPreFlight.pl"
  systemctl daemon-reload &>/dev/null || :
  systemctl stop carbonio-openldap.service &>/dev/null || :
  su - zextras -c "/opt/zextras/libexec/zmldapschema 2>/dev/null"
  /opt/zextras/libexec/zmldapupdateldif
  /opt/zextras/libexec/ldapattributeupdate
  systemctl restart carbonio-openldap.service &>/dev/null || :
}

_postinst_common() {
  chown -R root:root /opt/zextras/common/etc/openldap
  systemd-tmpfiles \
    --create /usr/lib/tmpfiles.d/carbonio-directory-server.conf \
    >/dev/null 2>&1 || :
}

_postinst_systemd_enable() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    systemctl enable carbonio-directory-server.target &>/dev/null || :
  fi
}

package() {
  _package
  _package_systemd
}

package__rocky_8() {
  _package
}

package__rocky_9() {
  _package
  _package_systemd
}

package__ubuntu_jammy() {
  _package
}

package__ubuntu_noble() {
  _package
  _package_systemd
}

preinst__rocky_8() {
  if [ "$1" -eq 2 ]; then
    su - zextras -c "/opt/zextras/bin/ldap start || true"
  fi
}

preinst__rocky_9() {
  if [ "$1" -eq 2 ] \
    && [ -d /run/systemd/system ]; then
    systemctl start carbonio-openldap.service &>/dev/null || :
  fi
}

preinst__ubuntu_jammy() {
  if [ "$1" = "upgrade" ] \
    && [ -n "$2" ]; then
    su - zextras -c "/opt/zextras/bin/ldap start || true"
  fi
}

preinst__ubuntu_noble() {
  if [ "$1" = "upgrade" ] \
    && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    systemctl start carbonio-openldap.service &>/dev/null || :
  fi
}

postinst__rocky_8() {
  _postinst_common
  if [ "$1" -eq 2 ]; then
    _ldap_upgrade_legacy
  fi
}

postinst__rocky_9() {
  _postinst_common

  if [ "$1" -eq 2 ] \
    && [ -d /run/systemd/system ]; then
    _ldap_upgrade_systemd
    systemctl start carbonio-openldap.service &>/dev/null || :
  fi

  _postinst_systemd_enable
}

postinst__ubuntu_jammy() {
  _postinst_common
  if [ "$1" = "configure" ] \
    && [ -n "$2" ]; then
    _ldap_upgrade_legacy
  fi
}

postinst__ubuntu_noble() {
  _postinst_common
  if [ "$1" = "configure" ] \
    && [ -n "$2" ] \
    && [ -d /run/systemd/system ]; then
    _ldap_upgrade_systemd
    systemctl start carbonio-openldap.service &>/dev/null || :
  fi
  _postinst_systemd_enable
}

prerm__rocky_9() {
  [ -d /run/systemd/system ] \
    && systemctl --no-reload disable --now \
      carbonio-directory-server.target &>/dev/null || :
}

prerm__ubuntu_noble() {
  [ -d /run/systemd/system ] \
    && systemctl --no-reload disable --now \
      carbonio-directory-server.target &>/dev/null || :
}

postrm__rocky_9() {
  [ -d /run/systemd/system ] \
    && systemctl daemon-reload &>/dev/null || :
}

postrm__ubuntu_noble() {
  [ -d /run/systemd/system ] \
    && systemctl daemon-reload &>/dev/null || :
}
