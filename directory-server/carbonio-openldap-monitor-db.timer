[Unit]
Description=Carbonio OpenLDAP Database Size Monitor Every 30 Minutes
Documentation=https://docs.zextras.com/
PartOf=carbonio-directory-server.target

[Timer]
OnCalendar=*:00/30
Persistent=true

[Install]
WantedBy=carbonio-directory-server.target
